 };
type PurchaseErrorCode = 
 variant {
   aboveRemaining:
    record {
      maximumIcpE8s: nat;
      maximumTtti: nat;
      requestedTtti: nat;
    };
   anonymousCaller;
   approvalMissing: record {allowance: nat;};
   autoDepositsDisabled;
   belowMinimum: record {
                   minimumTtti: nat;
                   requestedTtti: nat;
                 };
   deliveryFailedRefundFailed;
   deliveryFailedRefunded;
   icpLedgerError;
   insufficientIcp: record {balance: nat;};
   invalidAmount;
   notConfigured;
   presaleComplete;
   priceMoved: record {
                 maxIcpE8s: nat;
                 requiredIcpE8s: nat;
               };
   priceUnavailable;
   salesPaused;
