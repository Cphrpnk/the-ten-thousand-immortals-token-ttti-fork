  buyExactTtti: (recipient: opt Account, tttiAmount: nat, maxIcpE8s: 
   nat) -> (PurchaseResult);
  clearDeliveryAddress: () -> (bool);
  convertDeposit: (recipient: opt Account, icpAmount: nat) ->
   (PurchaseResult);
  execute: (qJson: text) -> (Result) query;
  exportBalanceSnapshot: () -> (BalanceSnapshot) query;
  getAdminSwitches: () -> (AdminSwitches) query;
  getApiDoc: () -> (text) query;
  getBalance: (canisterId: principal, account: Account) -> (BalanceResult);
  getBurnAccount: () -> (Account) query;
  getCallerIcpBalance: () -> (nat);
  getCallerUserProfile: () -> (opt UserProfile) query;
  getCallerUserRole: () -> (UserRole) query;
  getCanisterPrincipal: () -> (principal) query;
  getConversions: () -> (vec Conversion) query;
  getDeliveryAddress: () -> (opt Account) query;
  getFailedForwards: () -> (vec Conversion) query;
  getFeeCollector: () -> (FeeCollectorInfo) query;
  getIcpPrice: () -> (IcpPrice) query;
  getLegacyBlockInfo: () -> (LegacyBlockInfo) query;
  getOnRampLinks: () -> (vec OnRampLink) query;
  getOriginalWhitePaper: () -> (opt OriginalDocument) query;
  getPresaleStatus: () -> (PresaleStatus) query;
  getPublicTreasuryInfo: () -> (opt PublicTreasuryInfo) query;
  getTokenMetadata: (canisterId: principal) -> (TokenResult);
  getTreasuryConfig: () -> (opt TreasuryConfig) query;
  getTreasuryState: () -> (TreasuryState);
  getUserProfile: (user: principal) -> (opt UserProfile) query;
  get_fee: () -> (nat) query;
  get_fee_bounds: () -> (FeeBounds) query;
  get_max_supply: () -> (nat) query;
  handleDeposit: (icpAmount: nat) -> (PurchaseResult);
  icrc10_supported_standards: () -> (vec SupportedStandard) query;
  icrc1_balance_of: (account: Account) -> (nat) query;
  icrc1_decimals: () -> (nat8) query;
  icrc1_fee: () -> (nat) query;
  icrc1_metadata: () -> (vec record {
                               text;
                               MetadataValue;
                             }) query;
  icrc1_minting_account: () -> (opt Account) query;
  icrc1_name: () -> (text) query;
  icrc1_supported_standards: () -> (vec SupportedStandard) query;
  icrc1_symbol: () -> (text) query;
  icrc1_total_supply: () -> (nat) query;
  icrc1_transfer: (args: TransferArgs) -> (TransferResult__1);
  icrc2_allowance: (args: AllowanceArgs) -> (Allowance) query;
  icrc2_approve: (args: ApproveArgs) -> (ApproveResult);
  icrc2_transfer_from: (args: TransferFromArgs) -> (TransferFromResult);
  icrc3_get_archives: (args: GetArchivesArgs) -> (vec ArchiveInfo) query;
  icrc3_get_blocks: (args: vec GetBlocksArgs) -> (GetBlocksResult) query;
  icrc3_get_tip_certificate: () -> (opt DataCertificate) query;
  icrc3_supported_block_types: () -> (vec SupportedBlockType) query;
  initializeAccessControl: () -> ();
  isCallerAdmin: () -> (bool) query;
  listTokens: () -> (vec TokenDescriptor);
  mint: (to: Account, amount: nat) -> (MintResult);
  prepareTransfer: (canisterId: principal, from: Account, to: Account,
   amount: nat, memo: opt blob) -> (TransferResult);
  publishOriginalWhitePaper: (document: OriginalDocument) -> ();
  quoteExactTtti: (tttiAmount: nat) -> (ExactQuoteResult) query;
  refreshIcpPrice: () -> (PriceResult);
  retryTreasuryForward: (conversionId: nat) -> (ForwardRetryResult);
  saveCallerUserProfile: (profile: UserProfile) -> ();
  schema: () -> (text) query;
  setDeliveryAddress: (principalText: text) -> (DeliveryAddressResult);
  setFallbackEnabled: (enabled: bool) -> ();
  setOnRampLinks: (links: vec OnRampLink) -> ();
  setSalesPaused: (paused: bool) -> ();
  setTransfersFrozen: (frozen: bool) -> ();
  setTreasuryConfig: (config: TreasuryConfig) -> (TreasuryConfigResult);
  set_fee: (newFee: nat) -> (SetFeeResult);
  transform: (input: TransformationInput) -> (TransformationOutput) query;
}
